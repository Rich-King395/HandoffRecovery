# Configuration reference for the formal recovery batch entry point.
# The current low-level clients still require explicit configuration objects.
# Relative paths below resolve from HandoffRecovery's project root.
HANDOFFBENCH_ROOT=../ResumeBench/HandoffBench
LOCAL_MODELS_ROOT=../local-models

# Cloud Planner. Use the complete Chat Completions request endpoint.
# It is used verbatim; no /v1 or /chat/completions suffix is appended.
# Select the Planner provider used by the formal batch entry point.
# Provider blocks are independent so changing models does not overwrite prior settings.
RECOVERY_PLANNER_PROVIDER=qwen
# Registry adapter. Built in: openai_compatible. A custom adapter may use
# module:factory and receive PlannerConfig.
RECOVERY_PLANNER_ADAPTER=openai_compatible

# Qwen / DashScope-compatible Planner.
RECOVERY_PLANNER_QWEN_ENDPOINT=
RECOVERY_PLANNER_QWEN_API_KEY=
RECOVERY_PLANNER_QWEN_MODEL=qwen3.8-flash
RECOVERY_PLANNER_QWEN_DISABLE_THINKING=true
RECOVERY_PLANNER_QWEN_RESPONSE_FORMAT=json_schema

# OpenAI-compatible Planner (optional).
RECOVERY_PLANNER_OPENAI_ENDPOINT=
RECOVERY_PLANNER_OPENAI_API_KEY=
RECOVERY_PLANNER_OPENAI_MODEL=
RECOVERY_PLANNER_OPENAI_DISABLE_THINKING=

# Claude-compatible Planner (optional; use the project's compatible adapter URL).
RECOVERY_PLANNER_CLAUDE_ENDPOINT=
RECOVERY_PLANNER_CLAUDE_API_KEY=
RECOVERY_PLANNER_CLAUDE_MODEL=
RECOVERY_PLANNER_CLAUDE_DISABLE_THINKING=

# DeepSeek-compatible Planner (optional).
RECOVERY_PLANNER_DEEPSEEK_ENDPOINT=
RECOVERY_PLANNER_DEEPSEEK_API_KEY=
RECOVERY_PLANNER_DEEPSEEK_MODEL=
RECOVERY_PLANNER_DEEPSEEK_DISABLE_THINKING=

# The batch entry point chooses the GUI Agent from this one option.
# Supported values: phonebuddy, gui_owl, qwen, deepseek, openai, claude, ui_voyager, holo
RECOVERY_LOCAL_AGENT=phonebuddy
# Registry adapter. Built in: phonebuddy, gui_owl, qwen, deepseek, openai, claude. A custom adapter may use
# module:factory and receive (bench_path, ExecutorSpec).
RECOVERY_EXECUTOR_ADAPTER=phonebuddy

# PhoneBuddy settings (used when RECOVERY_LOCAL_AGENT=phonebuddy).
PHONEBUDDY_BASE_URL=http://127.0.0.1:8001/v1
PHONEBUDDY_MODEL=PhoneBuddy-4B
PHONEBUDDY_API_KEY=EMPTY
PHONEBUDDY_PROMPT_PATH=../ResumeBench/HandoffBench/.runtime/phonebuddy/phonebuddy_system_prompt.txt

# GUI-Owl settings (used when RECOVERY_LOCAL_AGENT=gui_owl).
GUI_OWL_BASE_URL=
GUI_OWL_MODEL=
GUI_OWL_API_KEY=EMPTY

# HandoffBench shared cloud GUI Agents (optional). Qwen uses the native
# DashScope route when QWEN_BASE_URL is empty and DASHSCOPE_API_KEY is set.
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_MAX_OUTPUT_TOKENS=4096
DASHSCOPE_API_KEY=
# Optional explicit credential alias. This is useful when the GUI Agent and
# Planner share a key but should keep their configuration blocks separate.
# QWEN_API_KEY_VAR=DASHSCOPE_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1/messages
CLAUDE_MODEL=
CLAUDE_API_KEY=
# HandoffBench's native Claude credential name; use this when the executor
# adapter reads the Anthropic-compatible endpoint.
CLAUDE_API_KEY_VAR=ANTHROPIC_API_KEY

# HandoffBench specialized local GUI Agents (optional).
UI_VOYAGER_BASE_URL=http://127.0.0.1:8000/v1
UI_VOYAGER_MODEL=UI-Voyager
UI_VOYAGER_API_KEY=EMPTY
HOLO_BASE_URL=http://127.0.0.1:8003/v1
HOLO_MODEL=Holo-3.1-4B
HOLO_API_KEY=EMPTY

# Device/Appium defaults.
RECOVERY_DEVICE_SERIAL=emulator-5574
RECOVERY_ADB_PATH=../ResumeBench/HandoffBench/.runtime/android-sdk/platform-tools/adb
RECOVERY_APPIUM_URL=http://127.0.0.1:4743
RECOVERY_ENVIRONMENT_BASELINE=../ResumeBench/HandoffBench/.runtime/environment-baselines/full-worker8-v1.json
# Python environment with HandoffBench/Appium dependencies. Leave blank to auto-detect it.
RECOVERY_PYTHON=

# detailed keeps each task's diagnostics during method development.
# compact removes bulky lifecycle evidence; summary removes each task directory
# after aggregation and keeps only the batch summary/report.
RECOVERY_RESULT_RETENTION=detailed
# Shared GUI decision budget; default 20, configurable from 1 to 200.
RECOVERY_MAX_DECISIONS=20
